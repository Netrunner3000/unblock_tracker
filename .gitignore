# Python
__pycache__/
*.pyc
.pytest_cache/

# Environments
venv/
.venv/
env/

# Local settings. config.json holds the user's own account and target handle,
# so it never gets committed. Secrets aren't here at all — they live in the
# macOS Keychain. config.example.json is the committed template.
config.json
.env
*.key

# Local tooling
.claude/settings.local.json
.DS_Store

# Run artifacts: logs, event CSVs, captured screenshots. These record activity
# about the monitored account — keep them local.
runs/
*.log
*.csv
*.db
*.zip
output/

# PyInstaller output. The .spec is regenerated by build_app.sh on every run,
# so the script is the source of truth, not a checked-in spec file.
build/
dist/
dist.noindex/
*.spec

# iconutil's input folder — a pure intermediate. icon.icns is the committed
# asset; make_icon.py regenerates both.
assets/icon.iconset/
