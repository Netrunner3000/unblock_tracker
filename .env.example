# Copy to .env and fill in. .env is git-ignored — never commit it.

# Instagram account the monitors log in as
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Instagram handle being monitored (no @)
TARGET_PROFILE=

# Telegram bot notifications — token from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pushbullet notifications — token from pushbullet.com/account
PUSHBULLET_TOKEN=
